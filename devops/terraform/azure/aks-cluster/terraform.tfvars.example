project         = "example"
environment     = "dev"
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus2"
owner           = "platform-team"

kubernetes_version = "1.34" # check `az aks get-versions --location eastus2`

# From network-hub-spoke outputs
node_subnet_id             = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example-dev-network/providers/Microsoft.Network/virtualNetworks/vnet-example-dev-aks/subnets/nodes"
log_analytics_workspace_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example-dev-network/providers/Microsoft.OperationalInsights/workspaces/log-example-dev"
outbound_type              = "userAssignedNATGateway"

admin_group_object_ids          = ["00000000-0000-0000-0000-000000000000"]
api_server_authorized_ip_ranges = ["203.0.113.0/24"]
