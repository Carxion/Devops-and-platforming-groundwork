---
# yamllint settings compatible with ansible-lint (which runs yamllint's rules itself).
extends: default
ignore: |
  .ansible/
  .cache/
  .venv/
rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  line-length:
    max: 160
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
