{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web-app values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "resources", "service"],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Images are pinned by digest."
        }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "platform-lib": { "type": "object", "description": "Added by Helm for the dependency; the library chart takes no values." },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "partOf": { "type": "string" },
    "image": { "$ref": "#/$defs/image" },
    "config": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Environment variables. Values must be strings: quote numbers and booleans."
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"]
        },
        "limits": {
          "type": "object",
          "required": ["memory"],
          "description": "A memory limit is required; a CPU limit is optional."
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "host": { "type": "string" },
        "tls": { "type": "array" },
        "allowFrom": { "type": "array" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "extraEgress": { "type": "array" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/$defs/image" }
      }
    }
  }
}
