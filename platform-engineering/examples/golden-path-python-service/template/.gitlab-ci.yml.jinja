# .gitlab-ci.yml
# {{ service_name }}'s pipeline, from the platform's Python golden path:
# checks with reports in the merge request; the image built, scanned, and
# pushed by the platform's component; then deployed with the platform's
# web-app chart, to dev automatically and to production by a person.
#
# The platform provides, per environment (Settings > CI/CD > Variables, with
# an environment scope): KUBECONFIG, a file variable for that environment's
# cluster, and KUBE_NAMESPACE. Production's are protected.
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS
      when: never
    - if: $CI_COMMIT_BRANCH
  auto_cancel:
    on_new_commit: interruptible

stages: [check, build, test, publish, deploy]

include:
  - component: $CI_SERVER_FQDN/{{ ci_components }}/container-image@1.0.0
    inputs:
      name: image
      build_tags: [image-build]

default:
  interruptible: true

variables:
  PLATFORM_CHART: oci://{{ platform_charts }}/web-app
  PLATFORM_CHART_VERSION: "{{ platform_chart_version }}"

.python:
  stage: check
  image: ghcr.io/astral-sh/uv:0.13.5-python3.14-trixie-slim
  variables:
    UV_FROZEN: "1"
    UV_CACHE_DIR: $CI_PROJECT_DIR/.uv-cache
    UV_LINK_MODE: copy
  cache:
    key:
      files: [uv.lock]
    paths: [.uv-cache/]
  after_script:
    - uv cache prune --ci

lint:
  extends: .python
  script:
    - uv run ruff format --check .
    - uv run ruff check --output-format=gitlab --output-file=gl-code-quality-report.json .
  artifacts:
    when: always
    reports:
      codequality: gl-code-quality-report.json

typecheck:
  extends: .python
  script:
    - uv run mypy

test:
  extends: .python
  script:
    - uv run pytest --junitxml=junit.xml --cov={{ module_name }} --cov-report=term --cov-report=xml:coverage.xml
  coverage: '/TOTAL.*\s(\d+(?:\.\d+)?)%/'
  artifacts:
    when: always
    reports:
      junit: junit.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

image-build:
  needs: [lint, typecheck, test]

# Deploy the pushed image, by digest, with the platform's chart and this
# service's values for the environment.
.deploy:
  stage: deploy
  image:
    name: alpine/helm:4.3.1
    entrypoint: [""]
  needs: [image-push]                  # its dotenv report provides IMAGE_REF
  interruptible: false
  script:
    - >
      helm upgrade --install "{{ service_name }}" "$PLATFORM_CHART"
      --version "$PLATFORM_CHART_VERSION"
      --namespace "$KUBE_NAMESPACE"
      -f "deploy/$CI_ENVIRONMENT_NAME.yaml"
      --set image.repository="${IMAGE_REF%@*}"
      --set image.tag=""
      --set image.digest="${IMAGE_REF#*@}"
      --wait --timeout 5m --rollback-on-failure

deploy-dev:
  extends: .deploy
  resource_group: dev                  # one deploy at a time per environment
  environment:
    name: dev
    deployment_tier: development
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

deploy-production:
  extends: .deploy
  resource_group: production
  environment:
    name: production
    deployment_tier: production
  needs: [image-push, deploy-dev]
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
