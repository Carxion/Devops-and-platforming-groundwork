project     = "example"
environment = "dev"
region      = "us-east-1"
owner       = "platform-team"

kubernetes_version = "1.34" # check `aws eks describe-cluster-versions`

# From network-vpc outputs
private_subnet_ids = ["subnet-0ddd", "subnet-0eee", "subnet-0fff"]

cluster_admin_principal_arns = [
  "arn:aws:iam::111122223333:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_PlatformAdmin_0123456789abcdef",
]
