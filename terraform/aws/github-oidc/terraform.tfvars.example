project = "example"
region  = "us-east-1"
owner   = "platform-team"

github_repository = "example-org/example-infra"
apply_environment = "production"

# From bootstrap-state outputs
state_bucket_arn  = "arn:aws:s3:::example-tfstate-111122223333-us-east-1"
state_kms_key_arn = "arn:aws:kms:us-east-1:111122223333:key/00000000-0000-0000-0000-000000000000"

apply_policy_arns              = ["arn:aws:iam::111122223333:policy/example-terraform-apply"]
apply_permissions_boundary_arn = "arn:aws:iam::111122223333:policy/example-pipeline-boundary"
